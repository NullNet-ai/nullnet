[Unit]
Description=Nullnet client
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/nullnet/members/nullnet-client
EnvironmentFile=/root/nullnet/members/nullnet-client/.env
ExecStart=/root/nullnet/target/release/nullnet-client
Restart=always
LimitNOFILE=524288

[Install]
WantedBy=multi-user.target
